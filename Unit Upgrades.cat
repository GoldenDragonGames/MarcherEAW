        <cost name="Supply" typeId="284c-5503-e866-a2e0" value="0"/>
        <cost name="Intel" typeId="2f82-38f2-c47a-db0a" value="0"/>
        <cost name="Activations" typeId="a4ae-e848-77a7-6d45" value="0"/>
      </costs>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="94d5-59a0-9da7-e434" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Officer Type" hidden="false" id="bb82-39b2-4692-0d58">
      <selectionEntryGroups>
        <selectionEntryGroup name="Officer Type" id="bbb1-3baa-0229-457c" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Armor Officer" hidden="false" id="2d14-3b1a-cb5b-e5a0">
              <rules>
                <rule name="Armor Officer" id="f70f-7326-1907-dcd2" hidden="false">
                  <description>During the Command Phase, this Unit may spend an Order Token, if it does, you may Mark a Target. To Mark a Target, select an Enemy Unit within LoS, until the end of this Round, all Attacks performed by Units in this Platoon against that Unit consider their Weapons to be Primary Weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Infantry Officer" hidden="false" id="02d0-161c-3655-c7d5"/>
            <selectionEntry type="upgrade" import="true" name="Recon Officer" hidden="false" id="8d2c-6601-a577-0ccb"/>
            <selectionEntry type="upgrade" import="true" name="Artillery Officer" hidden="false" id="da91-7075-aedb-9fc5">
              <rules>
                <rule name="Artillery Officer" id="27d6-1c05-8a41-f8f3" hidden="false">
                  <description>During the Command Phase, this Unit may spend an Order Token, if it does, you may advance the.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Mechanized Officer" hidden="false" id="5a77-f527-7e58-5281"/>
            <selectionEntry type="upgrade" import="true" name="Support Officer" hidden="false" id="572d-a36d-69a9-2f22"/>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
  </sharedSelectionEntries>
  <catalogueLinks>
    <catalogueLink type="catalogue" name="Special Rules" id="695f-3fb8-6f98-b434" targetId="1270-948e-6bd6-7ecc"/>
    <catalogueLink type="catalogue" name="Shared Weapons and Weapon Special Rules" id="7a0f-68a9-7cee-299d" targetId="54dd-0c6d-c00e-e51f"/>
  </catalogueLinks>
  <sharedRules>
    <rule name="Bolt-On Shield Generator" id="6db2-42c0-b23d-3b14" hidden="false">
      <description>Once per Round, as a Reaction, you may Activate this Unit&apos;s Shield Generator. If you do, gain the following effects:

Reduce the A.P. of all incoming Weapon Profiles by 2. 

• If this Unit has not Activated this Round it may spend any number of it’s Actions for the turn to reduce the A.P. by an additional 1

• Bulwark 3

Hits, Range, and A.P. may be decreased only to a minimum of 1.
These rules do not apply to Weapons with the Flames or Gas Special Rules.</description>
    </rule>
    <rule name="Emplaced Gun" id="2a7d-25c4-050d-de07" hidden="false">
      <description>During Deployment, you may choose for this Unit to be an Emplacement. If you do, instead of placing it on the Battlefield, this Unit may only be Deployed as if it were a Fortification with Supply Cost 2 for Carriage, 4 for Battery. If it is, it may no longer take any Movement Actions, and is considered to be in Light Cover. If this Unit is Towed it loses this level of Cover and may take Movement Actions again. If this Unit has any Ordnance X weapons, the Blast Tokens for those must be placed during the Command Phase even if this Unit has not yet been Deployed.</description>
    </rule>
    <rule name="Fuel Drums" id="e6e0-df35-6dc6-fb12" hidden="false">
      <description>Once per Game, when this Unit takes the Dash Action, it may do so with its full Movement Value.</description>
    </rule>
    <rule name="Professional NCO" id="1bdc-4350-03ab-d4ea" hidden="false">
      <description>During the Command Phase, if this Unit&apos;s original Leader Model has not been destroyed, it issues this Unit an Order.</description>
    </rule>
    <rule name="Radio Pack" id="9e5e-ab69-3f3f-545f" hidden="false">
      <description>Designate one Model in this Unit as a Radioman, if that Model is destroyed, this Unit loses the Radio and Forward Observer Special Rules.</description>
    </rule>
    <rule name="Up-Armored" id="1f7c-515a-0ef2-8614" hidden="false">
      <description>This Model&apos;s Armor Profile is increased by 1. This Model&apos;s Movement Profile is decreased by 2&quot;.</description>
    </rule>
    <rule name="Stable Firing Position" id="21b3-c7af-2fb8-5ab6" hidden="false">
      <description>If this Unit begins its activation in contact with terrain it gains an Aim Token.</description>
    </rule>
    <rule name="Pop Smoke" id="2789-0a67-eb65-f149" hidden="false">
      <description>As a Free Action or Free Reaction, you may expend one of this Weapon&apos;s Ammo, if you do, you may place a Smoke Token within 8” of this Unit.</description>
    </rule>
    <rule name="Flexible Hero" id="ba04-cce8-3db9-31d4" hidden="false">
      <description>This Unit may attach to a Unit in this Platoon as though it has the Designated Leader Special Rule, or be taken as a separate Unit.</description>
    </rule>
    <rule name="Smoke Token" id="3041-2233-c962-765d" hidden="false">
      <description>25mm base; Units within 6” of this Token gain a level of Obscured. Attacks passing through this 6” radius are considered to be taken through Obscuring terrain. At the beginning of the Command Phase, this Token Drifts, if you roll a 1 to Drift this Token is removed. If this Token has Drifted before, instead, remove this Token.</description>
    </rule>
    <rule name="Reinforced" id="8980-2d6d-00bc-ee76" hidden="false">
      <description>This Unit&apos;s Cover Level is improved by 1. This Cover applies in Melee. This Rule does not stack.</description>
    </rule>
    <rule name="Nominate Field Commander" id="653b-4795-0602-9a08" hidden="false">
      <description>This Unit is your Field Commander. (This Unit must have the highest Officer rank in your Army or be a Hero).</description>
    </rule>
    <rule name="Dozer Blade" id="1d25-6f5d-3ea6-dded" hidden="false">
      <description>This Unit has the Up-Armored Upgrade. This Unit may perform the Build Action as a Standard Action. If it does so, it may only Build an Embankment. This Unit may perform the Demolish Action as a Standard Action.</description>
    </rule>
    <rule name="Stun Grenade" id="b37f-f7a3-8cde-1fe4" hidden="false">
      <description>When performing an Attack with this Weapon, on a successful Hit, apply a Suppression Token.</description>
    </rule>
  </sharedRules>
