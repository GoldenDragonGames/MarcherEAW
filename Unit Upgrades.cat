    <selectionEntry name="Smoke Rounds" id="9849-be05-c218-855d" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="a3d5-12d3-8d4f-dee9" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <rules>
        <rule name="Smoke Rounds" id="109d-331a-dc5c-f936" hidden="false">
          <description>Once per Game, when making a Indirect Attack with this Unit, you may Expend this Round. If you do, instead of resolving the Attack, for each Blast Token you would select, replace that Token with a Smoke Token.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Beehive Rounds" id="f088-9f61-67d3-7008" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="662d-d247-72f0-2c1c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
