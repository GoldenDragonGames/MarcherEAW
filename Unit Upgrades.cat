    <selectionEntry type="upgrade" import="true" name="Beehive Rounds" hidden="false" id="f088-9f61-67d3-7008">
      <rules>
        <rule name="Beehive Rounds" id="9557-df2c-b98b-a2a9" hidden="false">
          <description>Once per Game, when making a Direct Fire Attack with this Unit, you may Expend this Round. If you do, until that Attack is Resolved, double that Weapon Profile&apos;s Hits value, set its AP to 2, and lower its Damage by half, that Weapon gains Scattershot.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Supply" typeId="284c-5503-e866-a2e0" value="0"/>
        <cost name="Intel" typeId="2f82-38f2-c47a-db0a" value="0"/>
        <cost name="Activations" typeId="a4ae-e848-77a7-6d45" value="0"/>
