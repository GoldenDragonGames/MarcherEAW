      <rules>
        <rule name="Incendiary Rounds" id="9804-b713-4607-1219" hidden="false">
          <description>Once per Game, when making a Direct Fire or Indirect Fire Attack with this Unit, you may Expend this Round. If you do, apply a Burning Token to all Units Targeted by this Attack.</description>
