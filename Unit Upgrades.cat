    <selectionEntry name="Lightning Rod" id="823f-cff0-6ffa-5d0c" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="3c39-098d-34d6-7e52" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Munitions" typeId="Points" value="10"/>
        <cost name="Supply" typeId="284c-5503-e866-a2e0" value="0"/>
        <cost name="Intel" typeId="2f82-38f2-c47a-db0a" value="0"/>
        <cost name="Activations" typeId="a4ae-e848-77a7-6d45" value="0"/>
