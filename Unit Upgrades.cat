      <rules>
        <rule name="APHE Rounds" id="140d-bf76-205b-39aa" hidden="false">
          <description>Once per Game, when making a Direct Fire Attack with this Unit, you may Expend this Round. If you do, that Weapon gains the Critical Shot Special Rule, and may reroll 1s for Armor Checks.</description>
        </rule>
