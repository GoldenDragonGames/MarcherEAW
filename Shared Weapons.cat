<catalogue name="Shared Weapons and Weapon Special Rules" id="54dd-0c6d-c00e-e51f" battleScribeVersion="2.03" gameSystemId="969e-2588-ed56-37c3" gameSystemRevision="1" library="true" revision="1" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedProfiles>
    <profile name="Anti-Tank Grenade" id="c0f6-4740-65bb-2819" hidden="false" typeId="Weapon" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="23fd-52ca-c658-ab9b">4&quot;</characteristic>
        <characteristic name="Hits" typeId="60de-dad6-12a2-68b4">2</characteristic>
        <characteristic name="Armor Penetration" typeId="a8b4-f834-f9e0-2df8">8</characteristic>
        <characteristic name="Damage" typeId="92d5-d0e9-5e47-86ca">6</characteristic>
        <characteristic name="Special Rules" typeId="d007-3244-18f1-86d1">Critical Shot</characteristic>
        <characteristic name="Keywords" typeId="bd5a-5880-4285-ad9f">Grenade</characteristic>
      </characteristics>
    </profile>
    <profile name="Bayonet" id="3137-3620-f900-f5b0" hidden="false" typeId="Weapon" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="23fd-52ca-c658-ab9b">E</characteristic>
        <characteristic name="Hits" typeId="60de-dad6-12a2-68b4">2</characteristic>
        <characteristic name="Armor Penetration" typeId="a8b4-f834-f9e0-2df8">1</characteristic>
        <characteristic name="Damage" typeId="92d5-d0e9-5e47-86ca">1</characteristic>
        <characteristic name="Special Rules" typeId="d007-3244-18f1-86d1">Charge!</characteristic>
        <characteristic name="Keywords" typeId="bd5a-5880-4285-ad9f">Melee, Kinetic, Bladed</characteristic>
      </characteristics>
    </profile>
    <profile name="Entrenching Tool" id="0b5d-250c-1a7d-1270" hidden="false" typeId="Weapon" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="23fd-52ca-c658-ab9b">E</characteristic>
        <characteristic name="Hits" typeId="60de-dad6-12a2-68b4">2</characteristic>
        <characteristic name="Armor Penetration" typeId="a8b4-f834-f9e0-2df8">2</characteristic>
        <characteristic name="Damage" typeId="92d5-d0e9-5e47-86ca">2</characteristic>
        <characteristic name="Special Rules" typeId="d007-3244-18f1-86d1">One-Handed</characteristic>
        <characteristic name="Keywords" typeId="bd5a-5880-4285-ad9f">Melee, Bladed, Kinetic</characteristic>
      </characteristics>
    </profile>
    <profile name="Steel Fists" id="ca5f-7842-d773-86ec" hidden="false" typeId="Weapon" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="23fd-52ca-c658-ab9b">E</characteristic>
        <characteristic name="Hits" typeId="60de-dad6-12a2-68b4">2</characteristic>
        <characteristic name="Armor Penetration" typeId="a8b4-f834-f9e0-2df8">2</characteristic>
        <characteristic name="Damage" typeId="92d5-d0e9-5e47-86ca">1</characteristic>
        <characteristic name="Special Rules" typeId="d007-3244-18f1-86d1"/>
        <characteristic name="Keywords" typeId="bd5a-5880-4285-ad9f">Melee, Blunt, Kinetic</characteristic>
      </characteristics>
    </profile>
    <profile name="Combat Shield" id="32f2-eb79-77ff-f463" hidden="false" typeId="Weapon" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="23fd-52ca-c658-ab9b">E</characteristic>
        <characteristic name="Hits" typeId="60de-dad6-12a2-68b4">2</characteristic>
        <characteristic name="Armor Penetration" typeId="a8b4-f834-f9e0-2df8">1</characteristic>
        <characteristic name="Damage" typeId="92d5-d0e9-5e47-86ca">2</characteristic>
        <characteristic name="Special Rules" typeId="d007-3244-18f1-86d1">Reinforced, One-Handed</characteristic>
        <characteristic name="Keywords" typeId="bd5a-5880-4285-ad9f">Melee, Blunt, Kinetic</characteristic>
      </characteristics>
    </profile>
    <profile name="Deploy Anchors" id="94fc-766e-deeb-4c71" hidden="false" typeId="029d-f6a3-b018-ca50" typeName="Action">
      <characteristics>
        <characteristic name="Effect" typeId="9f82-6862-14ed-dd50">This Unit may immediately perform a 45 degree Pivot. This Unit may not perform any additional Movement Actions this Round. This Unit is allowed to perform Attacks with Locking Weapons until the end of this Round.</characteristic>
      </characteristics>
    </profile>
    <profile name="Charge Capacitors" id="70ff-78fc-6ff0-113a" hidden="false" typeId="029d-f6a3-b018-ca50" typeName="Action">
      <characteristics>
        <characteristic name="Effect" typeId="9f82-6862-14ed-dd50">Roll three 7+ Charge Checks; for each success, gain a Charged Token
</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Ablation Beam" id="a397-8716-ab3d-2773" hidden="false">
      <description>When performing an Attack with Weapons with this Special Rule, each instance of a Weapon forms a separate Attack pool. For each successful Hit Check made by this Weapon, score an additional Hit and increase this Weapon&apos;s AP Profile by 1 for the rest of this Attack.</description>
    </rule>
    <rule name="Ammo X" id="2056-c454-be5c-ea02" hidden="false">
      <description>This weapon starts with X Ammo. This weapon may only be selected for the Attack Action if it has at least 1 Ammo remaining. After the attack Action is complete, reduce its Ammo by 1.</description>
    </rule>
    <rule name="Arc-Lightning" id="38d0-e689-0a64-8c94" hidden="false">
      <description>After resolving an Attack with this Weapon, you may roll a X+ check to see if the lightning jumps. On a success, select the nearest non-Flying Unit that is no more than 1D5&quot;+2 away from any Model in the previously Attacked Unit and that has not been targeted by this Weapon this Activation. Roll an Attack with this Weapon against that Unit as well. This may be done multiple times. Each time the lightning jumps, increase the Check requirement by +1.</description>
    </rule>
    <rule name="Bombard" id="0091-17ea-a67a-1ae9" hidden="false">
      <description>After resolving an Attack with this Weapon, make a Bombard Check for each Terrain Feature that was within the Radius of that Attack&apos;s Blast Token. When rolling Bombard Checks for this Weapon, +X to the check.</description>
    </rule>
    <rule name="Charge!" id="6a90-de57-2154-3db3" hidden="false">
      <description>When a Unit equipped with a Weapon with this Special Rule ends a Movement Action within Engagement Range of an Enemy Unit, it may immediately perform a Free Melee Attack Action. If it does, it may only select Weapons with this Special Rule.</description>
    </rule>
    <rule name="Cleave" id="039c-7032-df73-62bf" hidden="false">
      <description>Excess damage from this Weapon may spill over to one additional Model.</description>
    </rule>
    <rule name="Close In" id="6f53-dabe-1243-14cf" hidden="false">
      <description>When making an Attack with this Weapon, Units targeted by this Attack do not receive the benefit of Cover.</description>
    </rule>
    <rule name="Concussive" id="2535-84fb-dcc0-f3ac" hidden="false">
      <description>After resolving an Attack with Concussive Weapons, you may roll a Concussion Check. To roll a Concussion Check, roll 1D10 for each Weapon with Concussive in the Attack Pool, then add the amount of damage dealt by these weapons this round to the results. If this sum is equal to or greater than the current HP of the Unit Targeted by the Attack, apply a Concussion Token. 

Concussion Token: When this Unit Activates, remove all Concussion Tokens applied to it. For each Token removed, it loses one Action.</description>
    </rule>
    <rule name="Critical Shot" id="a53f-6c4f-8514-7703" hidden="false">
      <description>For each unmodified 10 you roll when Attacking with this Weapon, score an additional Hit.</description>
    </rule>
    <rule name="Direct Fire" id="371b-f82b-1fef-54a5" hidden="false">
      <description>When this Weapon is selected to make an Attack, place a Blast Token for each instance of this Weapon within Range and Line of Sight. You must select these Tokens to resolve Attacks with. This Weapon is considered to have the Inaccurate Special Rule.</description>
    </rule>
    <rule name="One-Handed" id="2082-d275-920b-519d" hidden="false">
      <description>Troop Models may select two Weapons to Attack with if both of them have this Special Rule.</description>
    </rule>
    <rule name="Flames" id="7235-63bc-0668-6ac4" hidden="false">
      <description>When making an Attack with this weapon, all Hits succeed automatically, then apply a Burning Token. When a Model carrying a Weapon with this Special Rule is Destroyed, apply a Burning Token to the Unit it was a part of, and any Units within 3&quot;.

Burning Token: A Unit may only have one Burning Token. When this Unit Activates, this Token makes a X/0/1 Attack against it, where X is the amount of HP the Unit has left. If more than half of these Hits fail to deal Damage, this Token is removed.</description>
    </rule>
    <rule name="Gas Projector" id="2196-346b-deab-9dce" hidden="false">
      <description>When making an attack with this weapon, place a Gas Token within range.</description>
    </rule>
    <rule name="Gas Token" id="a88e-c569-29b0-f610" hidden="false">
      <description>When the following Conditions are met, Units within 3&quot; of this Token are attacked by the Poison Gas Profile. 
◆ When the Unit begins its Activation.
◆ When the Unit Moves through the Area.
◆ When the Gas Token is placed.
A Unit may not be Attacked by the Poison Gas Profile more than once per Round.
Attacks that originate from within 3&quot; of this Token, or draw Line of Sight in such a way that the Attack passes through 3&quot; of this Token are subject to one additional level of Obscuration. At the beginning of the Command Phase, this Token Drifts, if you roll a 1 to Drift this Token is removed. If this Token has Drifted before, instead, remove this Token.</description>
    </rule>
    <rule name="Gas!" id="988c-e404-230a-1ee2" hidden="false">
      <description>Attacks with this Weapon automatically pass all Armor Penetration Checks.</description>
    </rule>
    <rule name="Grenade" id="e228-c7d5-d55a-053a" hidden="false">
      <description>This Weapon is not Equipped to a single Model, but instead to the entire Unit. When This Unit performs an Attack Action, it may select one instance of this Weapon in addition to all of its other weapons.</description>
    </rule>
    <rule name="Headshot" id="9d6c-a49e-e767-123d" hidden="false">
      <description>When resolving an Attack with this Weapon against a Unit with the Troops Keywords, for each Hit which is an unmodified 10, automatically pass the following Armor Check.</description>
    </rule>
    <rule name="Heat Ray" id="56bf-a271-a758-6f38" hidden="false">
      <description>When making an Attack with this Weapon, apply a Burning Token. You may not apply more than One Burning Token per Weapon Profile per Attack Action. When making an Attack with this Weapon, you may choose to Modulate. If you do, half this Weapon&apos;s Hits profile and double its Armor Penetration until this Attack is resolved.</description>
    </rule>
    <rule name="High Explosive" id="9375-d461-c135-9e66" hidden="false">
      <description>When Attacking a Multi-Model Unit with this Weapon, excess Damage spills over to other Models in that Unit.</description>
    </rule>
    <rule name="Inaccurate" id="3da9-a39d-1d0c-5ea1" hidden="false">
      <description>When making an Attack with this Weapon, -1 to Hit. Aim Tokens spent do not modify Hit Checks made by this Weapon.</description>
    </rule>
    <rule name="Indirect Fire" id="0648-3007-c58c-c884" hidden="false">
      <description>During the Command Phase, place a Blast Token for each instance of this Weapon within Range and no less than 12&quot; from this Unit. When making an Attack with this Weapon, it does not need Line of Sight to select a Blast Token. When a Blast Token is selected, it Drifts X&quot;, where X is this Weapon&apos;s Ordnance value. You may spend Aim Tokens to raise or lower the number rolled for the Drift direction or for the Drift distance by 1 for each Aim token. Remove the Token after resolving the Attack.</description>
    </rule>
    <rule name="Ordnance" id="11d9-c53a-4538-6b97" hidden="false">
      <description>During the Command Phase, decide if this Weapon is using Direct Fire or Indirect Fire. When making an Attack with this Weapon, each instance of it must select an eligible Blast Token, then resolve an Attack against every Unit within X&quot; of that Blast Token. When all eligible Attacks have been resolved, remove the Blast Token. This Weapon is considered to have the High Explosive, Precise, and Suppressive Special Rules.</description>
    </rule>
    <rule name="Point Blank" id="1e7a-7634-bb2b-1ff9" hidden="false">
      <description>This weapon may be selected to fire even if this unit is Engaged.</description>
    </rule>
    <rule name="Reliable" id="6859-e990-52c3-68cb" hidden="false">
      <description>When you make an Attack with this Weapon, for each failed Hit Check, reroll that Check. This may only be done once per Check.</description>
    </rule>
    <rule name="Scattershot" id="20e-bfac-4fc9-44b9" hidden="false">
      <description>While making an attack using a weapon with this special rule, if within half range of the target, double your Hits and AP Profile.</description>
    </rule>
    <rule name="Shield Bash" id="7325-1a3f-26e7-5f1e" hidden="false">
      <description>When an Attack is made with this Weapon, you may, instead of dealing damage, choose to move one enemy Troop Unit that this Unit is Engaged with 2&quot; in a direction of your choice. This movement is resolved after this Attack has been resolved.</description>
    </rule>
    <rule name="Silent" id="7bc9-bfc2-1e2e-ca13" hidden="false">
      <description>Reactions cannot be taken in response to Attacks from this Weapon.</description>
    </rule>
    <rule name="Slag" id="aaa4-8ad4-e93e-7ead" hidden="false">
      <description>After succeeding a Hit check with this Weapon Profile, apply a Slag Token. You may not apply more than One Slag Token per Weapon Profile per Attack Action.</description>
    </rule>
    <rule name="Suppressive" id="4911-2380-864d-8b44" hidden="false">
      <description>After resolving an Attack with Suppressive Weapons, for each Suppressive Weapon, apply a Suppression Token.</description>
    </rule>
    <rule name="Warding" id="f86d-acd5-05b1-927c" hidden="false">
      <description>When an Enemy Unit enters engagement range with a Unit equipped with this Weapon, immediately perform a Free Attack Action with this weapon against that Unit. This Attack occurs before all others are resolved.</description>
    </rule>
    <rule name="Spray" id="b609-fbd4-d0a3-6927" hidden="false">
      <description>After Attacking a Troop Unit with this Weapon Profile, apply a Spray Token. Units may not have more than one Spray Token.</description>
    </rule>
    <rule name="Sniper" id="3a32-9522-280e-50ce" hidden="false">
      <description>When making an Attack with this Weapon, the targeted Unit does not Receive the benefit of Cover. You may spend an Aim token to Snipe, if you do, you may select a Model in the targeted Unit, your Opponent must use that Model&apos;s statistics for the Attack, and must assign Damage to it first.</description>
    </rule>
    <rule name="Fixed Elevation" id="c0d5-a3ac-e545-c37a" hidden="false">
      <description>This Weapon may not use Direct Fire.</description>
    </rule>
    <rule name="Blast Token" id="5d4a-ecea-623a-a136" hidden="false">
      <description>When Resolving an Attack with this Token, you must Attack each Unit within X&quot; of this Token. (X specified by the Ordnance Special Rule) If this Token Drifts, you may spend Aim Tokens to raise or lower the number rolled for the Drift direction or for the Drift distance by 1 for each Aim token. Remove the Token after resolving the Attack.</description>
    </rule>
    <rule name="Burning Token" id="44ae-d6b8-8f9b-46c4" hidden="false">
      <description>A Unit may only have one Burning Token. When this Unit Activates, this Token makes a X/0/1 Attack against it, where X is the amount of HP the Unit has left. If more than half of these Hits fail to deal Damage, this Token is removed.</description>
    </rule>
    <rule name="Devastating Reach X" id="3f77-55e6-4481-2bde" hidden="false">
      <description>This Weapon&apos;s Engagement Range is X&quot;</description>
    </rule>
    <rule name="Precise" id="05ca-6100-212a-a9ca" hidden="false">
      <description>When making an Attack with this Weapon, Units targeted by this Attack do not receive the benefit of being Obscured.</description>
    </rule>
    <rule name="Suppression Token" id="9efa-0473-ec44-0cd5" hidden="false">
      <description>Any time you attempt to apply this Token to a Unit, you must roll a Suppression Check. A Unit may not have more Suppression Tokens applied to it than it has Models.

If a Unit has Suppression Tokens applied to it, the following rules apply:
* This Unit is considered &quot;Suppressed&quot;.
* While this Unit is Suppressed, all of its Ranged Weapons have the Inaccurate Special Rule, and for each Suppression Token applied to it, its Movement Value is reduced by 1&quot;.
* When this Unit Activates, if the number of Suppression Tokens applied to it is equal to the number of Models in the Unit, it must roll a Morale Check.</description>
    </rule>
    <rule name="Sustained Fire" id="ced7-eb92-01df-0845" hidden="false">
      <description>When performing an Attack Action, this Weapon may choose to gain the Inaccurate Special Rule. If it does, this Weapon applies an additional Suppression Token.</description>
    </rule>
    <rule name="Morale Check" id="929b-91fe-5a4d-d0e2" hidden="false">
      <description>For each Model in this Unit, roll a 6+ Check modified by this Unit&apos;s Bravery Bonus. For each Failure, one Model in this Unit flees and is removed from the Battlefield.</description>
    </rule>
    <rule name="Suppression Check" id="3427-2463-7d70-6479" hidden="false">
      <description>The score to pass this check is 5 + the Target&apos;s Bravery Bonus. On failure, the token is not applied.</description>
    </rule>
    <rule name="Spin Up" id="57cc-2904-33dc-1450" hidden="false">
      <description>When performing an Attack Action with this Weapon, you may expend any number of additional Actions. For each that you do, add another instance of this Weapon to the Attack pool.</description>
    </rule>
    <rule name="Bombard Check" id="bd31-32b8-cc8b-a1ce" hidden="false">
      <description>For each level of Cover this Terrain Feature has, roll a 7+ check. If all Checks are successful, apply a Bombard Token to this Terrain Feature.</description>
    </rule>
    <rule name="Bombard Token" id="239d-adc3-4bac-1f1b" hidden="false">
      <description>For each Bombard Token a Terrain Feature has, its Cover Level is reduced by one. If a Terrain Feature&apos;s Cover Level is lowered to 0, it is destroyed and removed from the Battlefield.</description>
    </rule>
    <rule name="Spray Token" id="f34c-af2a-18ad-414f" hidden="false">
      <description>All Attacks this Unit performs are subject to one additional level of Obscuration. Shed this Token at the end of this Unit&apos;s Activation.</description>
    </rule>
    <rule name="Charged Coils" id="9b0a-d697-e429-2a1b" hidden="false">
      <description>Units Equipped with this Weapon gain Charge Capacitors as a Standard Action. When this Unit performs an Attack with this Weapon, it may spend Charged Tokens. For each Token spent in this way it may apply one additional Slag Token.</description>
    </rule>
    <rule name="Slag Token" id="babf-a0e1-14f4-5e5f" hidden="false">
      <description>This Unit&apos;s Armor Value is reduced by 1. Shed this Token on this Unit&apos;s Activation.</description>
    </rule>
    <rule name="Reinforced" id="8980-2d6d-00bc-ee76" hidden="false">
      <description>This Unit&apos;s Cover Level is improved by 1. This Cover applies in Melee. This Rule does not stack.</description>
    </rule>
    <rule name="Innate Weapon" id="911e-9a8d-1992-85f5" hidden="false">
      <description>This Weapon may always be selected to Attack with, regardless of other Weapon selections.</description>
    </rule>
    <rule name="Blast" id="c55c-3ee4-a9f5-7d51" hidden="false">
      <description>When making an Attack with this Weapon, place a Blast Token within range, then resolve an Attack with this profile against all Units with X&quot; of that Blast Token. When all eligible Attacks have been resolved, remove the Blast Token.</description>
    </rule>
    <rule name="Degrading X" id="ec60-213d-dfad-2a02" hidden="false">
      <description>Each time you resolve an Attack Action with this weapon, reduce one of its Non-Range Profiles by X for the remainder of the game.</description>
      <alias>Degrading</alias>
    </rule>
    <rule name="Locking" id="3e6b-1e39-8925-3b7a" hidden="false">
      <description>In order to perform an Attack Action with this Weapon, this Unit must have also performed the Deploy Anchors Standard Action this Round.</description>
    </rule>
    <rule name="Amplified Beam" id="268b-ab91-da1a-6cb1" hidden="false">
      <description>Units Equipped with this Weapon gain Charge Capacitors as a Standard Action. When this Unit performs an Attack with this Weapon, it may spend Charged Tokens. For each Token spent in this way this Weapon automatically scores an additional Hit.</description>
    </rule>
  </sharedRules>
