<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="Special Rules" id="1270-948e-6bd6-7ecc" battleScribeVersion="2.03" gameSystemId="969e-2588-ed56-37c3" gameSystemRevision="1" library="true" revision="1" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedRules>
    <rule name="Aerial Deployment" id="7659-e620-db7c-3cfe" hidden="false">
      <description>Instead of deploying this Unit at the start of the game, you may declare that this model is in En Route. During any Setup Phase after the first Round you may deploy this unit anywhere on the battlefield no closer than 8&quot; from an Enemy Unit.</description>
    </rule>
    <rule name="All-Terrain-Vehicle" id="972a-0b3a-3523-56c4" hidden="false">
      <description>When this Unit enters Rough Terrain, roll a die, on a 5+, ignore the effect of Rough Terrain for the rest of the Round.</description>
    </rule>
    <rule name="Armored Recovery Vehicle" id="678f-05f0-b381-d9ce" hidden="false">
      <description>As an Action, this Unit may select a piece of Vehicle Wreckage Terrain that it is within 1&quot; of and remove that Model. If it does, gain 5 Supply Points.</description>
    </rule>
    <rule name="Automated Kill-Zone" id="7f86-a20d-20cf-f425" hidden="false">
      <description>This Unit is always considered to be Overwatching. This Unit may make two Overwatch Attacks per round. This Unit may receive Order Tokens, if it does, it may spend the Tokens to perform additional Overwatch Actions. This Unit may not make multiple Attacks per round against the same target.</description>
    </rule>
    <rule name="Bailout" id="e024-3b5a-3d53-c103" hidden="false">
      <description>If this Model is destroyed while Units are Embarked within it, for each Unit, roll a 4+ Bailout Check for each Model Embarked. For each failure, a Model in that Unit is Destroyed. Then place the Unit within 3&quot; of the destroyed Transport.</description>
    </rule>
    <rule name="Battlefield Preparation" id="df67-26f7-b945-7b74" hidden="false">
      <description>At the beginning of the first Action Phase, this Unit may immediately take a free Build or Demolish Action.</description>
    </rule>
    <rule name="Big Game Hunter" id="7061-202c-dbbf-9c6e" hidden="false">
      <description>When making an Attack with this Unit against a non-Light Vehicle Unit, you may reroll failed Hits.</description>
    </rule>
    <rule name="Bulwark X" id="aec5-cc4d-2950-d314" hidden="false">
      <description>Attacks made against this Unit lower their Damage profile by X to a minimum of 1. Instances of this rule do not stack.</description>
    </rule>
    <rule name="Burrowing" id="7566-ca13-0639-188c" hidden="false">
      <description>Instead of deploying this Unit at the start of the game, you may declare that this Unit is in En Route. During any Setup Phase after the first Round, place one Taupe Token for Free anywhere on the Battlefield no closer than 8&quot; from an Enemy Unit. This Unit exits that Taupe Token, and must be set up within 3&quot; of it.</description>
    </rule>
    <rule name="Catastrophic Detonation" id="1e80-eb25-7926-0850" hidden="false">
      <description>When this Unit is destroyed, roll a D10, on a roll of 6+, perform an Attack Action (Profile:H:5, AP:5, D:5, High Explosive) against all Units within 3&quot;. If this Attack is performed, this Model does not leave Wreckage on the Battlefield.</description>
    </rule>
    <rule name="Coaxial Mount" id="427c-1744-659c-f265" hidden="false">
      <description>Weapons equipped in Coaxial Mounts may be selected to fire alongside a Difficult to Use Weapon, so long as they select the same target.</description>
    </rule>
    <rule name="Command Car" id="b3a8-6d2c-8217-042c" hidden="false">
      <description>This Unit, and all Units within 12&quot; of this Unit, are within the Radio Network. Once per Round, when this Unit issues an Order, choose a different Unit within the Radio Network, that Unit also gains an Order Token.</description>
    </rule>
    <rule name="Formation (Specified)" id="5ffd-5449-427f-b767" hidden="false">
      <description>This Model may only be Attached to Units with Name or Keyword(s) listed:</description>
    </rule>
    <rule name="Cook Off" id="6b8c-f368-911d-de1c" hidden="false">
      <description>When this Unit is destroyed, roll a D10, on a roll of 8+, perform an Attack Action (Profile:H:4, AP:4, D:4, High Explosive) against all Units within 3&quot;. If this Attack is performed, this Model does not leave Wreckage on the Battlefield.</description>
    </rule>
    <rule name="Critical Shot" id="03aa-1bbc-a35a-39d0" hidden="false">
      <description>For each unmodified 10 you roll when Attacking with this Weapon, score an additional Hit.</description>
    </rule>
    <rule name="Crushing Footfalls" id="e746-74b4-9340-0b9c" hidden="false">
      <description>When this Model moves through Light or Medium terrain, remove it from the battlefield. When this model is set up onto the battlefield you may remove one piece of Light or Medium terrain that falls under its base’s footprint.</description>
    </rule>
    <rule name="Cumbersome" id="a105-2c5d-bb1d-e679" hidden="false">
      <description>Units with this Special Rule may not be selected to Activate until all other non-Cumbersome Units in your Army have Activated this Round.</description>
    </rule>
    <rule name="Bailout (Dangerous)" id="6100-8e4c-f566-2b4a" hidden="false">
      <description>If this Model is destroyed while Units are Embarked within it, for each Unit, roll a 6+ Bailout Check for each Model Embarked. For each failure, a Model in that Unit is Destroyed. Then place the Unit within 3&quot; of the destroyed Transport.</description>
      <alias>Dangerous Bailout</alias>
    </rule>
    <rule name="Designated Leader" id="1f95-fa4a-51e0-80f8" hidden="false">
      <description>This Model must be attached to a non-Command Unit that it shares a CORE Keyword with in this Platoon before the Game starts. After this Model is attached it must be designated as the Leader of the combined Unit. A Unit may not have more than one additional Model attached to it in this way.</description>
    </rule>
    <rule name="Dishonorable Conduct" id="b8f8-a0c3-8f84-ba71" hidden="false">
      <description>If this Unit is destroyed, the Player who selected it as the target of an Attack loses 1 Victory Point. 


(If this Unit is selected as the target unintentionally, such as due to the Cook Off Special Rule, no points are deducted. If this Unit is intentionally moved into danger, such as through a minefield or into range of a Blast token, and is destroyed as a result, no points are deducted.)</description>
    </rule>
    <rule name="Distributed Command" id="843a-aa4f-52ab-704e" hidden="false">
      <description>Before the Game Starts, the Models in this Unit separate and individually Attach to different Units. That Unit gains all Special Rules associated with that Model. A Unit may not have more than one Model from a Distributed Command Unit attached to it.</description>
    </rule>
    <rule name="Distributed Elements" id="d9d0-c54d-43af-97d9" hidden="false">
      <description>Each Model in this Selection must Attach to a different Unit in this Platoon.</description>
    </rule>
    <rule name="Embarkable" id="1437-6e22-3bef-ad8b" hidden="false">
      <description>This Unit may be Embarked in a Transport. Taking this Unit adds a Transport slot to this platoon.</description>
    </rule>
    <rule name="Emplaced Gun" id="8caf-59a3-e259-7b8e" hidden="false">
      <description>During Deployment, you may choose for this Unit to be an Emplacement. If you do, instead of placing it on the Battlefield, this Unit may only be Deployed as if it were a Fortification with Supply Cost 2 for Carriage, 4 for Battery. If it is, it may no longer take any Movement Actions, and is considered to be in Light Cover. If this Unit is Towed it loses this level of Cover and may take Movement Actions again.</description>
    </rule>
    <rule name="Flexible Hero" id="efe9-c813-2eee-25dc" hidden="false">
      <description>This Unit may attach to a Unit in this Platoon as though it has the Designated Leader Special Rule, or be taken as a separate Unit.</description>
    </rule>
    <rule name="Forward Observer" id="06cc-f6e7-91a7-93c8" hidden="false">
      <description>This Unit gains &quot;Adjust Coordinates&quot; as a Standard Action. When it uses this Action it may select any Blast tokens within Line of Sight and 18&quot; of itself. Any Aim tokens this Unit has may be used by Friendly Siege Units.</description>
    </rule>
    <rule name="Forward Positions" id="6834-a3ab-58a5-6849" hidden="false">
      <description>This Unit may be Deployed outside of your Deployment Zone as long as it is more than 8” away from the Enemy Deployment Zone or any Enemy Unit.</description>
    </rule>
    <rule name="Gun Shield" id="93e5-0065-1a9d-9a1b" hidden="false">
      <description>When an Attack targets this Unit from within its Firing Arc, increase its Armor Value by 2 until the Attack is resolved.</description>
    </rule>
    <rule name="Heavy Carriage" id="ffeb-7559-d07e-4e60" hidden="false">
      <description>This Unit may only be Towed by Models with more than 10 starting HP.</description>
    </rule>
    <rule name="Hippocratic Oath" id="88b2-7240-2107-9262" hidden="false">
      <description>This Unit may not take the Attack Action. This Unit may not Move into Engagement with another Unit.</description>
    </rule>
    <rule name="Hitch" id="fcb1-fb43-02f5-c52a" hidden="false">
      <description>This Unit has access to the Free action “Tow”. A Towable Unit may be deployed along with this Unit already being Towed. If this Unit has more than one Model, it may Tow that many Carriage Models, even if they are in a Battery.</description>
    </rule>
    <rule name="Hunter" id="84cf-7abc-e526-e12f" hidden="false">
      <description>When this Unit destroys the Leader Model of an Enemy Command Unit, gain 1 Intel point.</description>
    </rule>
    <rule name="Independent Hero" id="f6c8-1880-1355-e3a2" hidden="false">
      <description>This Hero is a Unit, and may not attach to other Units. This Unit may not take Upgrades.</description>
    </rule>
    <rule name="Intel Gathering" id="05b0-6a7a-880f-304c" hidden="false">
      <description>As a Standard Action, gain an Intel Point (IP)</description>
    </rule>
    <rule name="Intelligence" id="814e-ef53-3526-90f8" hidden="false">
      <description>At the beginning of each Command Phase gain an Intel point (IP).</description>
    </rule>
    <rule name="Light on their Feet" id="14e9-14bf-78dd-c693" hidden="false">
      <description>This Unit may take the Fallback Reaction while losing only a single Action during its following Activation.</description>
    </rule>
    <rule name="Limited Elevation" id="d90a-8467-4874-4efd" hidden="false">
      <description>Ordnance Weapons equipped to this Unit may not use Indirect Fire.</description>
    </rule>
    <rule name="Logistics" id="af13-fb89-f837-db7e" hidden="false">
      <description>At the beginning of each Command phase gain a supply point (SP).</description>
    </rule>
    <rule name="Lookout" id="8036-018e-4f5b-1296" hidden="false">
      <description>This Unit may take the Sentry Action as a Standard Action.</description>
    </rule>
    <rule name="Low Profile" id="25bb-2209-81ba-ee30" hidden="false">
      <description>This Unit may only be selected as the target of an Attack if it is the closest Enemy Unit to the Attacker.</description>
    </rule>
    <rule name="Mounted Attache" id="0172-64b2-5794-a915" hidden="false">
      <description>This Selection does not have a Model, it must Mount a Vehicle or Carriage Unit within its Platoon.</description>
    </rule>
    <rule name="Officer X" id="6de5-545b-2ac4-744e" hidden="false">
      <description>This Unit may issue X Order(s) to Units within their Platoon or with the same CORE type that it is within 8&quot; of. When it issues an Order to a Unit, that Unit gains an Order Token. Units may not have more than one Order Token.</description>
    </rule>
    <rule name="On Assignment" id="0448-1717-5e42-e0e0" hidden="false">
      <description>This Unit has a base of three Actions.</description>
    </rule>
    <rule name="Open Topped X" id="7608-aac0-48a4-2e10" hidden="false">
      <description>Units embarked within this Transport may take Actions other than Reactions, Build and Capture without disembarking. They may be selected as the Target of Ranged Attacks. Units embarked within this Transport receive X levels of Cover. When making Attacks against Units embarked within this Transport, Line-Of-Sight is drawn to this Model.</description>
    </rule>
    <rule name="Patch-Up" id="296f-6c65-a341-cfab" hidden="false">
      <description>This Unit may perform the Patch Up Action as a Standard Action or as a Difficult Action. It may not do both in one Activation. As a Standard Action, select a friendly Non-Automaton, Non-Battlesuit Troop Unit within 3&quot; (including this unit). Restore 1D5 worth of HP to that Unit. Destroyed Models may be returned in this way, but all Models in the Unit must be at their maximum HP before another Model may be returned. As a Difficult Action, you may instead return 1D5+3 HP. You may not return Attache or Automaton models with this Rule.</description>
    </rule>
    <rule name="Personal Shield Generator" id="e8c1-89c2-d8a1-75c2" hidden="false">
      <description>Once per Round, as a Reaction, you may Activate this Unit&apos;s Shield Generator. If you do, gain the following effects:


• Reduce the number of Hits of all incoming Weapon Profiles by 1.
• If this Unit has not Activated this Round it may spend any number of its Actions for the
turn to reduce the Hits by an additional 1.
• Bulwark 1

Hits, Range, and A.P. may be decreased only to a minimum of 1.
These rules do not apply to Weapons with the Flames or Gas Special Rules.</description>
    </rule>
    <rule name="Protector" id="ae91-3aa7-cd14-cd8c" hidden="false">
      <description>Damage dealt to Friendly Troop or Cavalry Units within 6&quot; of this Unit may instead be applied to this Unit&apos;s Models.</description>
    </rule>
    <rule name="Prototype" id="4612-4b7b-8ffe-ed3c" hidden="false">
      <description>This Unit does not presently have an official model from Golden Dragon Games</description>
    </rule>
    <rule name="Raise the Banner" id="8126-75b0-4721-8842" hidden="false">
      <description>All Units within 12&quot; of this Flag may use this Model&apos;s Bravery Bonus instead of their own.</description>
    </rule>
    <rule name="Rapid Deployment" id="bed7-c4f3-15ed-2888" hidden="false">
      <description>At the start of the first Action Phase, this Unit may immediately take a Free Move action. They may not end this movement within Engagement Range of an Enemy Unit.</description>
    </rule>
    <rule name="Rapid Fortification" id="1306-6680-4b8c-9636" hidden="false">
      <description>When a Unit in the platoon is selected to perform the Build action, Immediately gain 1 Supply Point.</description>
    </rule>
    <rule name="Rapid Reconnaissance" id="8a4a-3ae1-c2de-6436" hidden="false">
      <description>All Units in the selected Platoon can take the Move Action more than once an activation, as a Standard Action.</description>
    </rule>
    <rule name="Rare Materiel X" id="e1ea-7376-65cf-20b1" hidden="false">
      <description>You may not take more than X selections of this Unit in your Army per 2000 Munitions, or half that many at lower Munition levels.</description>
    </rule>
    <rule name="Rupture" id="a49f-3cb5-cb1f-7b2f" hidden="false">
      <description>When this Unit is destroyed, place a Gas Token on top of it. This token does not drift and remains for the rest of the game.</description>
    </rule>
    <rule name="Bailout (Safe)" id="8e16-6a0a-60b0-dedb" hidden="false">
      <description>If this Model is destroyed while Units are Embarked within it, for each Unit, roll a 2+ Bailout Check for each Model Embarked. For each failure, a Model in that Unit is Destroyed. Then place the Unit within 3&quot; of the destroyed Transport.</description>
      <alias>Safe Bailout</alias>
    </rule>
    <rule name="Slippery" id="e1f9-41ef-ff64-d030" hidden="false">
      <description>If a Vehicle Mounted by this Unit is destroyed, place this Unit&apos;s Infantry Model in base-to-base contact with it at the end of the current activation. While not attached to another Unit, this Unit activates independently and gains the “Troop” Keyword.</description>
    </rule>
    <rule name="Supply Gathering" id="3f5f-2e30-c979-3f80" hidden="false">
      <description>As a Standard Action, gain a Supply Point (SP)</description>
    </rule>
    <rule name="Tank Destroyer" id="338c-b939-0d55-cde3" hidden="false">
      <description>This Unit may take the Overwatch Action as a Standard Action.</description>
    </rule>
    <rule name="Thin Armor" id="a202-a363-cb17-876f" hidden="false">
      <description>This Unit&apos;s Armor reduces by 1 additional point when Attacked in its Side or Rear Profiles.</description>
    </rule>
    <rule name="Trailer" id="f4f8-4eb7-5192-b746" hidden="false">
      <description>This Unit does not Activate as normal and may not perform Actions. This Unit may not take Upgrades. It may be detached from a Unit towing it on that Unit&apos;s turn as a free action.</description>
    </rule>
    <rule name="Transport X" id="1fce-f78c-f02d-eeae" hidden="false">
      <description>You may Embark X Troops Units in this Transport.</description>
    </rule>
    <rule name="Singular" id="7a26-c952-fe2c-529f" hidden="false">
      <description>This Unit may not have Attaches.</description>
    </rule>
    <rule name="(CORE) Flex" id="18aa-27f1-0ef7-3fa1" hidden="false">
      <description>This Officer is considered to have all CORE types. If this Officer attaches to a Unit, it gains the CORE type of the Unit it attached to and loses all others.</description>
    </rule>
    <rule name="Dial In X" id="ff6d-dccf-e9fa-094b" hidden="false">
      <description>During the Command Phase, set the Dial In Counter to 0.  Each time a Unit activates, tick the Counter up by one. If a Unit performs 3 or more Actions or uses a Difficult Action, tick the Counter up an additional time. Until the Counter reaches X, this Unit has the Cumbersome Special Rule. If this Unit is a Battery, its score to reach is increased to X instead.</description>
      <alias>Dial In</alias>
    </rule>
    <rule name="Jump-Packs" id="fd2f-2557-0580-c397" hidden="false">
      <description>This Unit&apos;s Evasion Score is increased by 2. Once per Activation, this Unit may Move as a Free Action, if it does, it may gain the Flying Keyword. At any point during this Unit’s Activation or any of its subsequent Activations it may choose to remove this keyword. This Unit must remove the Flying keyword should it wish to enter Engagement with a Unit without the Flying Keyword.</description>
    </rule>
    <rule name="Battlefield Scanners" id="55ab-d297-8493-eecc" hidden="false">
      <description>When making an Attack Action this Unit ignores one level of Obscuration.</description>
    </rule>
    <rule name="Gun Tractor" id="3420-b82e-13ac-47b2" hidden="false">
      <description>When a Unit this being Towed by this Unit takes the Detach Action, that Unit may make a Free Dash Action.</description>
    </rule>
    <rule name="Amphibious" id="2dc5-c4d9-8aed-acf3" hidden="false">
      <description>This Unit ignores the penalty for Water and Depths Terrain Features.</description>
    </rule>
    <rule name="Amphibious Assault" id="ad32-2660-48d5-ff7b" hidden="false">
      <description>This Unit may be Deployed outside of your Deployment Zone on any Water Feature larger than it as long as it is more than 8” away from the Enemy Deployment Zone or any Enemy Unit.</description>
    </rule>
    <rule name="Submersible" id="7ae0-7f6c-c4aa-0009" hidden="false">
      <description>Instead of deploying this Unit at the start of the game, you may declare that this Unit is in En Route. During any Setup Phase after the first Round, you may deploy this Unit on any Water Feature or Depths Water Feature that is larger than it. If it is Deployed on a Depths Water Feature, it may be within 8&quot; of Enemy Units, otherwise, it must be deployed at least 8&quot; away from all Enemy Units.</description>
    </rule>
    <rule name="Crash Landing" id="3d65-30df-710f-6fff" hidden="false">
      <description>When this Unit is destroyed, remove the Model from the battlefield and place a 25mm token in the center of where its base was. This token Drifts, but when determining the distance this token Drifts, add this Unit&apos;s Movement Value to the result. Perform an Attack Action (Profile:H:5, AP:5, D:5, High Explosive) against all Units within 3&quot; of the Token along its entire path. This Model does not leave Wreckage on the Battlefield.</description>
    </rule>
    <rule name="Bailout (Aerial)" id="dfa3-76f0-a139-f719" hidden="false">
      <description>If this Model is destroyed while Units are Embarked within it, if those Units do not have the Flying Keyword or the Jump Packs Special Rule, they are Destroyed. If they do, for each Unit, roll a 6+ Bailout Check for each Model Embarked. For each failure, a Model in that Unit is Destroyed. Then place the Unit within 3&quot; of the destroyed Transport.</description>
      <alias>Aerial Bailout</alias>
    </rule>
    <rule name="Sealed" id="429e-1178-6b2a-e940" hidden="false">
      <description>Attacks with the Gas! Special Rule may not target this Unit.</description>
    </rule>
    <rule name="Flak Shells" id="62d1-9898-61a2-0033" hidden="false">
      <description>This Unit&apos;s Autocannon and Machine Gun Weapons may reroll failed Hits against Units with the Flying Keyword.</description>
    </rule>
    <rule name="Setting Up!" id="7278-007d-f597-4cb3" hidden="false">
      <description>This Unit may not be selected to Activate until another Friendly Unit has Activated. If the previous Unit selected to Activate in this Army had this Rule, this Unit may not be selected to Activate. This Rule may be ignored If all remaining Friendly Units have this Special Rule or the Cumbersome Special Rule.</description>
    </rule>
    <rule name="Dispersed Transport" id="a52e-192e-3784-7fe0" hidden="false">
      <description>If a Model in this Unit is destroyed but the Unit itself was not, this Unit loses the Transport Keyword and all Units Embarked in this Transport must Bailout. No more than half of the Embarked Unit may be Destroyed via Bailout.</description>
    </rule>
    <rule name="Shared Qualities X" id="7ea1-cd1c-ca34-9368" hidden="false">
      <description>The Unit this Attache is Attached to gains the X subtype(s)</description>
    </rule>
    <rule name="Fire on My Command" id="7893-6f05-38fa-3023" hidden="false">
      <description>During the Command Phase, in place of issuing one Order, this Unit may designate an Enemy Unit within Line of Sight as a Primary Target. Until the end of the Round, Units in this Platoon consider all of their weapons to be Main Guns when the Primary Target is the target of their Attack.</description>
    </rule>
    <rule name="Fixed Loadout" id="ef41-70ca-bb42-13b3" hidden="false">
      <description>This Unit may not take Upgrades.</description>
    </rule>
    <rule name="Formation (Restricted)" id="13fd-2906-0702-b7c8" hidden="false">
      <description>This Model may not be Attached to Units with Name or Keyword(s) listed:</description>
    </rule>
    <rule name="Untrained" id="64d9-bdf9-0795-bbe2" hidden="false">
      <description>Each time this Unit attempts to perform an Action, if has already performed two Actions this Round, roll a 6+ Check, on failure, that Action fails.</description>
    </rule>
    <rule name="Armored Personnel Carrier" id="9da2-bcd3-ff52-8355" hidden="false">
      <description>Units that began their Activation within this Unit may take a Free Dash Action to Disembark.</description>
    </rule>
    <rule name="Armored Guardian" id="97f8-e657-8b6a-e3cc" hidden="false">
      <description>Attacks targeting this Model must use its Bravery Bonus for Suppression Checks. This Model&apos;s Armor Value may exceed 10.</description>
    </rule>
    <rule name="Order Token" id="555b-e260-0d9a-3cef" hidden="false">
      <description>This Unit gains one Action. This Token is removed when this Unit ends its Activation.</description>
    </rule>
    <rule name="Attached Heavy Weapon" id="c1ef-fd70-5e4d-a012" hidden="false">
      <description>This Model may not be selected to Attack if this Unit has performed a Movement Action this Activation.</description>
    </rule>
    <rule name="Landing Craft" id="30ea-a7ac-210a-a932" hidden="false">
      <description>Units that Disembark from this Unit spend no Movement to do so.</description>
    </rule>
    <rule name="Specialist Grenadier" id="6133-5acb-7342-ed63" hidden="false">
      <description>This Model is a Grenadier, and may not be selected for Attack Actions. Grenade Weapons used by this Unit are considered to have a Range of 12&quot;.</description>
    </rule>
    <rule name="Terror X" id="0ce4-7d3b-2b96-0e5a" hidden="false">
      <description>Troop Units that target this Unit must pass a X+ Terror Check modified by their Bravery Bonus; on failure, they must immediately perform a Fallback Reaction at a cost of 1 Action. The Unit must move the maximum distance rolled for the Fallback.</description>
    </rule>
    <rule name="Everybody Out!" id="e2a3-fef0-dc07-add3" hidden="false">
      <description>When this Unit is Deployed, all Models Embarked within it must immediately Disembark. This does not cost them an Action.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry name="Aerial Deployment" id="4a83-5712-b9b5-9366" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="103b-def3-aed1-41f3-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="103b-def3-aed1-41f3-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Munitions" typeId="Points" value="10"/>
        <cost name="Supply" typeId="284c-5503-e866-a2e0" value="0"/>
        <cost name="Intel" typeId="2f82-38f2-c47a-db0a" value="0"/>
        <cost name="Activations" typeId="a4ae-e848-77a7-6d45" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Aerial Deployment" id="Aerial Deployment" hidden="false" targetId="7659-e620-db7c-3cfe" type="rule"/>
