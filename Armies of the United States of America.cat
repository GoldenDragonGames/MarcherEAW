            <cost name="Munitions" typeId="Points" value="5"/>
            <cost name="Supply" typeId="284c-5503-e866-a2e0" value="0"/>
            <cost name="Intel" typeId="2f82-38f2-c47a-db0a" value="0"/>
            <cost name="Activations" typeId="a4ae-e848-77a7-6d45" value="1"/>
          </costs>
          <entryLinks>
            <entryLink name="Equipment, Upgrades, and Designations" id="8d38-b361-1896-c67e" hidden="false" import="true" targetId="f9bd-97ad-a621-5069" type="selectionEntryGroup"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Troop Actions" id="0a2a-83e7-6ef1-612a" hidden="false" targetId="0936-84e8-76d0-501a" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="X19A2 Badger Hardsuit Squad" id="121a-3eb9-5135-55b3" hidden="false" typeId="0322-11e4-8667-bbe3" typeName="Unit Composition">
              <characteristics>
                <characteristic name="Composition" typeId="1f57-7b47-fc27-63ac">1x X19A2 Badger Hardsuit Sergeant, &amp; 1-3x X19A2 Badger Hardsuits</characteristic>
                <characteristic name="Keywords" typeId="8b2b-8745-edb5-df14">USA, (CORE) Infantry, (AUX) Starborne, (AUX) Support, Troop, Battlesuit, Heavy</characteristic>
                <characteristic name="Base Size" typeId="d264-e5f6-d2b5-2624">40mm</characteristic>
                <characteristic name="Models in Unit" typeId="79fc-3188-cd1e-2b49">2-4</characteristic>
                <characteristic name="Upgrade Slots" typeId="a4fe-57aa-eb89-f8f4">1</characteristic>
              </characteristics>
            </profile>
            <profile name="Rush" id="5200-3c5b-2eee-e5ef" hidden="false" typeId="1e78-f7f5-b081-afe4" typeName="Reaction">
              <characteristics>
                <characteristic name="Trigger" typeId="95ce-77b7-e0e4-3c1b">Upon a Friendly Troop unit within 12&quot; of this one being selected as the target of an Attack.</characteristic>
                <characteristic name="Effect" typeId="84f0-157a-5005-b9a9">Until this Action is resolved, this Unit gains Bulwark 1 and all of its Equipped Weapons gain the Charge! Special Rule.


This Unit may move up to 1D5+4&quot; towards the Attacking Unit. If it ends this Movement closer to the Attacking Unit than the targeted Unit, it must be selected as the target of that Attack instead.</characteristic>
              </characteristics>
            </profile>
