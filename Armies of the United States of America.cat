              <rules>
                <rule name="The Citadel Graduate" id="d627-28ac-899d-a84b" hidden="false">
                  <description>If a Unit receives Orders from this Officer, it gains the following bonuses:
First Order: Gain a Level of Cover until this Unit&apos;s next Activation. (This rule may be applied to all Units as if they have the Troop Keyword).
Second Order: This Unit may take the Brace or Button Up Reactions at the cost of 1 Action instead of 2 this Round.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Virginia Military Institute Graduate" id="1a09-d5c9-d7ce-2232" hidden="false" import="true" type="upgrade">
