  <sharedRules>
    <rule name="One Track Programming" id="b193-2930-d1eb-db82" hidden="false">
      <description>When this Unit makes a Standard Attack Action, it must Attack the nearest eligible Enemy Unit</description>
    </rule>
    <rule name="Satellite Communication" id="fc68-0b29-f0a9-6edc" hidden="false">
      <description>This Unit ignores the requirements for Line of Sight and Range when performing the &quot;Direct Fire&quot; action.</description>
    </rule>
    <rule name="Eyes and Ears" id="1f18-fdd8-a7a4-4d2f" hidden="false">
      <description>When a Friendly Unit performs an Attack Action, if its target is within 12&quot; of this Unit it gains an Aim Token.</description>
    </rule>
    <rule name="Rough Riders" id="4d77-6a20-5c93-bc4c" hidden="false">
      <description>If this Unit Destroys an Enemy Unit with more than 5HP at the start of the Attack, it may make a Free Movement Action.</description>
    </rule>
    <rule name="Air Assault" id="199a-3ffc-a974-b5c3" hidden="false">
      <description>Instead of deploying this Unit as normal, place a Drop Token anywhere on the Battlefield. During the Action Phase you may select this Unit to deploy, if you do, select a Drop Token; that Token Drifts. After resolving the Drift, replace the Drop Token with this Unit&apos;s Leader Model, and place the rest of the Unit within cohesion. 


If this Unit has the Flying Keyword, you may deploy them without resolving the Token&apos;s Drift.</description>
    </rule>
  </sharedRules>
