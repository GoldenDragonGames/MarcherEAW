            <profile name="General George S. Patton" id="2c24-d590-42f0-0b12" hidden="false" typeId="312c-13ed-50aa-27a6" typeName="Attache Composition">
              <characteristics>
                <characteristic name="Keywords" typeId="d6ab-192f-515b-f06b">USA, (CORE) Armor, Attache (Vehicle), Hero, Command</characteristic>
                <characteristic name="Base Size" typeId="7451-1f52-67d5-01a8">25mm</characteristic>
