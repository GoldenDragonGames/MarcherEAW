              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Emergency Medicine" id="a113-0c53-0dd5-33e7" hidden="false">
              <description>As an action, select all Troop Units within 6&quot; of this one. Each of those Units either restores all HP lost by a Model or revives a destroyed Model, returning it to the Unit with 1 HP remaining</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="C-15 White Dove Medivac Shuttle" id="84d0-8e3d-5c16-20bc" hidden="false" import="true" type="model">
