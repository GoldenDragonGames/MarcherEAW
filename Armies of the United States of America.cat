          </costs>
          <entryLinks>
            <entryLink name="Equipment, Upgrades, and Designations" id="2ba6-89d0-6205-0ba4" hidden="false" import="true" targetId="f9bd-97ad-a621-5069" type="selectionEntryGroup"/>
