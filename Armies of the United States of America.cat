            <profile name="C-15 White Dove Medivac Shuttle" id="1fd9-a8b3-587d-9852" hidden="false" typeId="0322-11e4-8667-bbe3" typeName="Unit Composition">
              <characteristics>
                <characteristic name="Composition" typeId="1f57-7b47-fc27-63ac">0x Weapon Mounts</characteristic>
                <characteristic name="Keywords" typeId="8b2b-8745-edb5-df14">USA, (CORE) Mechanized, (CORE) Starborne, Vehicle, Flying, Medium</characteristic>
                <characteristic name="Base Size" typeId="d264-e5f6-d2b5-2624">N/A</characteristic>
