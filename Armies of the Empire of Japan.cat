              <characteristics>
                <characteristic name="Composition" typeId="1f57-7b47-fc27-63ac">1x Shugo-Yoroi Gunsō &amp; 1-3x Shugo-Yoroi</characteristic>
                <characteristic name="Keywords" typeId="8b2b-8745-edb5-df14">IJM, (CORE) Mechanized, (AUX) Infantry, (CORE) Retainer, Troop, Battlesuit, Heavy</characteristic>
                <characteristic name="Base Size" typeId="d264-e5f6-d2b5-2624">40mm</characteristic>
