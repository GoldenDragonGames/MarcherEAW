  <sharedInfoGroups>
    <infoGroup name="Japanese Faction Rules" id="98f7-f462-1297-93de" hidden="false">
      <rules>
        <rule name="Trained Reflexes" id="5842-2d29-8809-2708" hidden="false">
          <description>When a Unit with the EOJ Keyword performs a Reaction, they may perform a Reflex Check. To do so, roll a die for each Action they would lose when performing the Reaction. On a 7+, they do not lose that Action.</description>
        </rule>
        <rule name="Kimigayo" id="2048-f057-4388-76a7" hidden="false">
          <description>When a Unit with the EOJ Keyword performs the Dash Action, they may reroll all dice involved, keeping the higher results.</description>
        </rule>
      </rules>
    </infoGroup>
  </sharedInfoGroups>
