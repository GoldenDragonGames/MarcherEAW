            </profile>
            <profile name="Wrestle" id="5ed4-51e6-6cde-004e" hidden="false" typeId="1e78-f7f5-b081-afe4" typeName="Reaction">
              <characteristics>
                <characteristic name="Trigger" typeId="95ce-77b7-e0e4-3c1b">Upon being selected as the target of a Melee Attack.</characteristic>
                <characteristic name="Effect" typeId="84f0-157a-5005-b9a9">Select a Unit within Engagement Range of this Unit to Wrestle with. Both Units must immediately roll a D10. This Unit adds 1 to their roll for every model remaining. The Unit with the lowest total roll is moved 3&quot; away from the other to a point their Opponent specifies.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Dohyō-iri" id="7d70-a2e5-21de-9a02" hidden="false">
              <description>This Unit has the Wrestle Action as a Free Action or a Free Reaction. This Unit must be within 3&quot; of an Objective to use the Wrestle Action.</description>
            </rule>
          </rules>
