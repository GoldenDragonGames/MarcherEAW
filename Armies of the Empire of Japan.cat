    <selectionEntryGroup name="Army Specializations" id="b6b6-cead-9011-c778" hidden="false">
      <selectionEntries>
        <selectionEntry name="IJA 4th Division “Muramasa-Heidan”" id="7284-b2af-8bcd-1900" hidden="false" import="true" sortIndex="1" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization does not allow you to take Units with the IJN Keyword">
              <conditions>
                <condition childId="7b62-662e-b4a3-f92f" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Bushi Katagi" id="7567-ab78-c28b-3b43" hidden="false">
              <description>Vehicle units in your army gain the Intelligence Special Rule.


Units in your army with the Engaged condition get +2 to the A.P. characteristic of all of their weapons targeting Units they are Engaged with.</description>
            </rule>
            <rule name="Kōyō Gunkan" id="b22c-0093-094b-38a4" hidden="false">
              <description>Units in your army receive +1 Evasion and +1 Armor when selected as the target of an attack at greater than half range. 
*This does not count as Cover</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IJN Special Naval Landing Force “Jōriku Sentai Dai-Ichiban”" id="df55-35b0-0c3d-b7f6" hidden="false" import="true" sortIndex="2" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization does not allow you to take Units with the IJA Keyword">
              <conditions>
                <condition childId="d34f-eedb-f296-27aa" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Ichiya-jō" id="9707-1b85-2807-bc59" hidden="false">
              <description>All Troop Units gain the Build Action as a Standard Action.


All Non-Troop Units gain the “Logistics” keyword.</description>
            </rule>
            <rule name="Tenshu" id="0c93-b45d-70f4-65e6" hidden="false">
              <description>In the Command Phase of the first Battle Round, you may deploy up to 3 Supply Points worth of Terrain anywhere on the battlefield at least 6” away from your opponent’s Deployment Zone.
*note that you do have to spend the Supply Points to create these Fortifications as normal.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IJM Joint Indochina Task Force “Indoshina Gōdō Guntai”" id="ced5-80f6-f1f8-dd60" hidden="false" import="true" sortIndex="3" type="upgrade">
          <rules>
            <rule name="Yakibata" id="b49a-aba2-097c-79a2" hidden="false">
              <description>All Interservice Rivalry restrictions are removed.
* This means that you may take both Army and Navy units, and any rules or abilities that would normally turn off because of this do not.</description>
            </rule>
            <rule name="Resourceful" id="1fd9-97db-d325-11ab" hidden="false">
              <description>You may spend Intel and Supply points interchangeably.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IJN Rikusentai 3rd Division “Kure-Sanban”" id="0115-478c-0f6d-7c50" hidden="false" import="true" sortIndex="4" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization does not allow you to take Units with the IJA Keyword">
              <conditions>
                <condition childId="d34f-eedb-f296-27aa" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Ambush Fighters" id="4258-8de2-01b6-6335" hidden="false">
              <description>When a Troops Unit or Walker Unit in this Army ends a Move or Dash Action within 3” of a Table Edge, you may spend an Intel Point, if you do, they may be removed from Play and placed En Route. In the Setup Phase of any Subsequent Round, Units placed En Route in this fashion may be deployed within 3” of any Table Edge, 8” away from any Enemy Units.</description>
            </rule>
            <rule name="Each Blade of Grass" id="ef29-79e1-2509-6adc" hidden="false">
              <description>Units in this Army may ignore one instance of Obscuration when making Ranged Attack Actions.


Attacks made against Units in this Army by Minefields must re-roll successful Hits.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IJA 1st Tank Division “Taku”" id="5906-bda1-3922-141e" hidden="false" import="true" sortIndex="5" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization does not allow you to take Units with the IJN Keyword">
              <conditions>
                <condition childId="7b62-662e-b4a3-f92f" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
            <modifier field="error" type="add" value="This Specialization requires at least 1 Armor Platoon">
              <conditions>
                <condition childId="fae0-4a12-4ae4-5f9b" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Hagane no Zen&apos;ei" id="37fe-8034-9cf7-bcf3" hidden="false">
              <description>Tracked Vehicle Units in your army count as having 2x their remaining health for the purposes of holding objectives. 


Tracked Vehicle units in this army may re-roll Hit Rolls of 1 when within 3” of an Objective Marker under their control.</description>
            </rule>
            <rule name="Coordinated Assault" id="b022-8660-a5cb-4ed7" hidden="false">
              <description>Once per round, when a Tracked Vehicle Unit in this Army makes an Attack Action, you may select another Tracked Vehicle Unit within 8’’of the attacking Unit. This Unit may make a free Attack Action against the same target with one weapon profile even if it has already activated. This Free Attack Action may only be made if the selected weapon is within range and line of sight. Both Attacking Units gain an Aim token.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Imperial Guard 5th Division “Konoe Shidan”" id="af48-8935-19ff-49ba" hidden="false" import="true" sortIndex="6" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization does not allow you to take Units with the IJN Keyword">
              <conditions>
                <condition childId="7b62-662e-b4a3-f92f" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
            <modifier field="error" type="add" value="This Specialization does not allow you to take more than one Armor or Artillery Platoon">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="fae0-4a12-4ae4-5f9b" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="greaterThan" value="1"/>
                    <condition childId="d61b-5a5c-9008-3c0b" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="greaterThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Tenno Heika Banzai!" id="3c6d-b6c8-8c7d-60e4" hidden="false">
              <description>Troop Units in this army gain the “Shock Assault”reaction.</description>
            </rule>
            <rule name="Shock Assault" id="322d-0c67-0d1b-8b5e" hidden="false">
              <description>When this unit is targeted by an attack by a Unit it is not Engaged with, this unit may move 1d5+1” towards the nearest enemy unit.</description>
            </rule>
            <rule name="Exhaust All Resources" id="4d61-2b1c-f694-74db" hidden="false">
              <description>After taking a Reaction instead of rolling a die to recover an action as part of the Trained Reflexes National Ideal, Units in your army may instead spend a supply point to recover that Action instead.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Ebisu Special Boarding Unit “Tokkeitai”" id="daf1-2c6e-69f5-1302" hidden="false" import="true" sortIndex="7" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization does not allow you to take Units with the IJA Keyword">
              <conditions>
                <condition childId="d34f-eedb-f296-27aa" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Experimental Plasma" id="94b8-4cb3-b405-6d82" hidden="false">
              <description>At the beginning of the Round, select an attunement for your Plasma weapons. Plasma Weapons in your Army keep this bonus until the end of the round. You may not select a bonus more than once each game. 


After making an Attack with a Plasma Weapon, roll a d10 for each Plasma Weapon fired. On a 9+, the experimental Plasma overheats and is temporarily disabled, and that weapon may not be used the next time that Unit activates.</description>
            </rule>
            <rule name="Attunement" id="306e-352f-cb02-4d8d" hidden="false">
              <description>Dispersed Plasma: Plasma weapons gain High Explosive
Magnified Plasma: Plasma weapons gain Suppressive
Breaching Plasma: Reroll failed Charge Checks for the Charged Coils Special Rule
Liquid Plasma: Plasma weapons gain Close In</description>
            </rule>
            <rule name="Concentrated Fire" id="8ae2-1035-f323-f702" hidden="false">
              <description>When selecting a Unit for an Attack Action, you may spend Slag Tokens on the Targeted Unit, for each that you do, remove that token from the Unit, and gain one bonus from the following list for the remainder of the Attack Action:
* Plasma weapons reroll failed Hits once per Attack Action
* Plasma weapons reroll failed Armor Penetration once per Attack Action
* Attacks made by Plasma Weapons get +1 to their Damage
* Attacks made by Plasma Weapons +1 to the Hits Profile</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
