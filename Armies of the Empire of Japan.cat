          <rules>
            <rule name="Seiei Muhi" id="4e15-5d5f-a2c1-d13c" hidden="false">
              <description>When this unit performs a movement Action that could move them to or past the board edge, you may remove this Unit from the battlefield and place them En Route. They may be set up during the Setup Phase within 4” of the board edge, and 8” away from enemy models.</description>
            </rule>
