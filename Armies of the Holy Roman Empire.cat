                    <characteristic name="Hits" typeId="60de-dad6-12a2-68b4">1</characteristic>
                    <characteristic name="Armor Penetration" typeId="a8b4-f834-f9e0-2df8">0</characteristic>
                    <characteristic name="Damage" typeId="92d5-d0e9-5e47-86ca">1</characteristic>
                    <characteristic name="Special Rules" typeId="d007-3244-18f1-86d1">Concussive</characteristic>
                    <characteristic name="Keywords" typeId="bd5a-5880-4285-ad9f">Melee, Blunt, Kinetic</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="I&apos;ll Call In a Favor!" id="c685-730e-fe8d-d833" hidden="false">
                  <description>The Long-Range Artillery Special Requisition costs 1 fewer I.P.</description>
                </rule>
                <rule name="I was Quite Famous Back in the Day!" id="2f67-2225-338c-1127" hidden="false">
                  <description>While this Unit is within 8&quot; of an Enemy Unit, its Special Rules may not affect any other Units within your Army. If, at the end of Game this Unit remains on the Battlefield, gain 2 VP. If this Unit is Destroyed, your Opponent gains 1 VP.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Gefreiter Josef Švejk" id="1192-1742-945b-450d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e078-118c-7e33-1afe" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Munitions" typeId="Points" value="80"/>
            <cost name="Supply" typeId="284c-5503-e866-a2e0" value="0"/>
            <cost name="Intel" typeId="2f82-38f2-c47a-db0a" value="0"/>
            <cost name="Activations" typeId="a4ae-e848-77a7-6d45" value="0"/>
          </costs>
          <profiles>
            <profile name="Gefreiter Josef Švejk" id="f822-cfcd-0b24-65ba" hidden="false" typeId="312c-13ed-50aa-27a6" typeName="Attache Composition">
              <characteristics>
                <characteristic name="Keywords" typeId="d6ab-192f-515b-f06b">HRE, Hero</characteristic>
                <characteristic name="Base Size" typeId="7451-1f52-67d5-01a8">32mm</characteristic>
                <characteristic name="Maximum Number in Platoon" typeId="d3f4-a3f4-2fe1-5fee">1</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="The Good Soldier Svejk" id="bc7a-ac95-3fde-200c" hidden="false">
              <description>Svejk is not deployed on the table as other Units are. Instead, after all Deployment has completed and before the first Round begins, select one Troop Unit in your opponent&apos;s army. Attach Svejk to this Unit - for all rules purposes such as Line of Sight, Cohesion, Damage Allocation, Movement, etc., Svejk is treated as a Token. Svejk can never be selected to take damage for any reason. If the Unit that Svejk is attached to has been destroyed, he is removed from play.


When the Unit that Svejk is attached to is selected to activate, its owner must roll a die, and apply the result as follows until its next Activation;


* 10-8 - The Unit activates as normal, though Svejk will complain about it.
* 7-6 - The Unit gains one additional Suppression token, and must re-roll successful Suppression checks.
* 5-4 - The Unit cannot perform any Actions other than Move, Disengage, Attack, or Dig In.
* 3-2 - The Unit loses all Ordered status effects.
* 1 - The Unit immediately completes its Activation and ends the Turn.


In addition, if a Unit that Svejk is attached to attempts to perform a Reaction, roll a die. On an 8+, the Reaction automatically fails and the Unit&apos;s actions are consumed.</description>
            </rule>
            <rule name="Not Leadership Material" id="42ec-5911-90ff-0406" hidden="false">
              <description>Gefreiter Josef Švejk may not be selected to be your Field Commander.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Gefreiter Josef Švejk" id="53e4-e6ed-b493-b26e" hidden="false" import="true" type="model">
              <constraints>
                <constraint id="f04a-f03e-934b-86f3-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="f04a-f03e-934b-86f3-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
