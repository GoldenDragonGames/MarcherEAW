        <infoLink name="Degrading X" id="4cd0-1d17-c773-012b" hidden="false" targetId="ec60-213d-dfad-2a02" type="rule">
          <modifiers>
            <modifier arg="X" field="name" type="replace" value="1D5"/>
            <modifier arg="X" field="description" type="replace" value="1D5"/>
          </modifiers>
        </infoLink>
        <infoLink name="Locking" id="3fe6-6273-de92-8ffc" hidden="false" targetId="3e6b-1e39-8925-3b7a" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Magspring" id="a173-4b24-085f-2442" hidden="false">
          <description>When performing an Attack Action with this Weapon, instead of selecting a Target, instead draw a line starting at the base of the weapon and traveling directly down the length of the barrel across the entire Battlefield. Then, perform an Attack against each Unit this line crosses other than this one. Afterwards, apply a Bombard Token* to every Terrain Feature this line crosses.


* This token is automatically applied and does not require a check.</description>
        </rule>
      </rules>
    </selectionEntry>
