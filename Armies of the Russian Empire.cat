          </profiles>
          <rules>
            <rule name="Troop Carriage" id="1bcd-7789-7504-d360" hidden="false">
              <description>Once per Game, during this Model&apos;s activation, as a Difficult Action, you may use the Reinforcements Special Requisition. ignore the end of round timing requirement. If you do, the selected Unit returns with all Models, and is deployed with 4&quot; of this Model.</description>
            </rule>
          </rules>
