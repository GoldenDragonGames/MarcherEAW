  <sharedInfoGroups>
    <infoGroup name="Russian Faction Rules" id="e589-1e04-d9d6-0a03" hidden="false">
      <profiles>
        <profile name="Category 1" id="b581-f8bc-0991-c97e" hidden="false" typeId="c141-3197-a403-b085" typeName="The Blizzard">
          <characteristics>
            <characteristic name="Score To Increase" typeId="fe39-6149-4e68-b51f">5+</characteristic>
            <characteristic name="Score To Maintain" typeId="c1f2-cd31-ea40-488c">N/A</characteristic>
            <characteristic name="Effect" typeId="477a-4bf9-6e6e-9caf">All Ranged Attacks are Obscured once.</characteristic>
          </characteristics>
        </profile>
        <profile name="Category 2" id="8579-e1b8-e84f-3690" hidden="false" typeId="c141-3197-a403-b085" typeName="The Blizzard">
          <characteristics>
            <characteristic name="Score To Increase" typeId="fe39-6149-4e68-b51f">6+</characteristic>
            <characteristic name="Score To Maintain" typeId="c1f2-cd31-ea40-488c">5+</characteristic>
            <characteristic name="Effect" typeId="477a-4bf9-6e6e-9caf">Every time a Unit Activates, apply one Suppression Token to it.</characteristic>
          </characteristics>
        </profile>
        <profile name="Category 3" id="4034-9439-509d-1608" hidden="false" typeId="c141-3197-a403-b085" typeName="The Blizzard">
          <characteristics>
            <characteristic name="Score To Increase" typeId="fe39-6149-4e68-b51f">8+</characteristic>
            <characteristic name="Score To Maintain" typeId="c1f2-cd31-ea40-488c">6+</characteristic>
            <characteristic name="Effect" typeId="477a-4bf9-6e6e-9caf">All Units count as half health for the purposes of Objective Control.</characteristic>
          </characteristics>
        </profile>
        <profile name="Category 4" id="ab7e-2343-4d1d-52dd" hidden="false" typeId="c141-3197-a403-b085" typeName="The Blizzard">
          <characteristics>
            <characteristic name="Score To Increase" typeId="fe39-6149-4e68-b51f">10+</characteristic>
            <characteristic name="Score To Maintain" typeId="c1f2-cd31-ea40-488c">8+</characteristic>
            <characteristic name="Effect" typeId="477a-4bf9-6e6e-9caf">All Movement is considered to be over Rough Terrain.</characteristic>
          </characteristics>
        </profile>
        <profile name="Category 5" id="191e-2a51-10e7-7875" hidden="false" typeId="c141-3197-a403-b085" typeName="The Blizzard">
          <characteristics>
            <characteristic name="Score To Increase" typeId="fe39-6149-4e68-b51f">10+</characteristic>
            <characteristic name="Score To Maintain" typeId="c1f2-cd31-ea40-488c">9+</characteristic>
            <characteristic name="Effect" typeId="477a-4bf9-6e6e-9caf">All Weapons gain the Innaccurate Special Rule.</characteristic>
          </characteristics>
        </profile>
        <profile name="Category 6" id="8f76-5baa-655a-2a18" hidden="false" typeId="c141-3197-a403-b085" typeName="The Blizzard">
          <characteristics>
            <characteristic name="Score To Increase" typeId="fe39-6149-4e68-b51f">10+</characteristic>
            <characteristic name="Score To Maintain" typeId="c1f2-cd31-ea40-488c">9+</characteristic>
            <characteristic name="Effect" typeId="477a-4bf9-6e6e-9caf">Every time a Unit activates, it must make three Morale Checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="General Winter" id="3604-5784-f6dc-34e0" hidden="false">
          <description>At the beginning of the game, before any units are placed on the battlefield, The Blizzard condition is applied to the entire battlefield, starting at Category 1. The Blizzard may not gain more than one Category Level per Round. At the end of each Round, if the Blizzard Category has not been increased or maintained, it loses one Category.</description>
        </rule>
        <rule name="Acclimated" id="0b7f-a7e1-4825-868d" hidden="false">
          <description>Units with the RUS keyword are affected by two fewer Category Levels of the Blizzard Condition.
 
Units with the RUS keyword may automatically shed one Suppression Token each time they Activate.</description>
        </rule>
      </rules>
    </infoGroup>
  </sharedInfoGroups>
