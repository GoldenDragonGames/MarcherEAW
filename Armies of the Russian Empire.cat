    <selectionEntryGroup name="Army Specializations" id="470c-9b95-d455-c173" hidden="false">
      <selectionEntries>
        <selectionEntry name="2nd Guard Corps 43rd Division (Regency)" id="02a1-f184-a1c6-e862" hidden="false" import="true" sortIndex="1" type="upgrade">
          <profiles>
            <profile name="Forwards for Mother Russia!" id="2f3b-2682-2c11-3836" hidden="false" typeId="60a8-a233-a953-97f1" typeName="Special Requisition">
              <characteristics>
                <characteristic name="Cost" typeId="fdc2-ccd7-0950-5670">2 SP</characteristic>
                <characteristic name="Effects" typeId="8280-2b12-dd95-5313">Anytime a Friendly Vehicle with a Troop Unit Embarked within it completes its activation; you may select the Troop Unit within it to immediately activate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Deep Battle" id="bd78-5fe5-3166-eaf9" hidden="false">
              <description>Troop Units with the RUS Keyword may embark in Non-Transport Vehicle Units with the Tracked keyword as if they have “Transport 1&quot; and &quot;Open Topped 1&quot;. If a Vehicle with Units Embarked in this way is destroyed, use the “Dangerous Bailout” rule to see which Embarked Models survive.</description>
            </rule>
            <rule name="Belaya Gvardiya" id="0882-8a95-69d3-2493" hidden="false">
              <description>Vehicles with Troop Units embarked within them may take the Capture Action as a Free Action.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="3rd Caucasus Cossack Division (Sandroviks)" id="95a0-858f-8ee0-973b" hidden="false" import="true" sortIndex="3" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization requires at least one Recon Platoons">
              <conditions>
                <condition childId="df9c-5241-555f-2018" field="forces" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Zaporozhian Cossacks" id="1c2a-8e8a-1467-cb17" hidden="false">
              <description>CORE Recon Units in your army get +1 to hit for each time they have moved this round. 


Cossack Units in your army reroll failed Armor Penetration Checks</description>
            </rule>
            <rule name="New Aged Cavalry" id="b557-2276-8137-f577" hidden="false">
              <description>If a Cossack Unit is within 6’’ of a Friendly Walker Unit when targeted with a ranged attack, you can elect for the Walker to be the target of the attack instead. 


CORE Recon Units with the Vehicle keyword gain an aim token whenever they end a movement within 6” of a Cossack Unit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Alaskan Defense Corps 17th Division " id="289f-7e3d-d55d-8fdd" hidden="false" import="true" sortIndex="2" type="upgrade">
          <rules>
            <rule name="Scorched Earth" id="d124-c694-5d7a-b42f" hidden="false">
              <description>At the beginning of each Command Phase, starting on round 2, you may spend a Victory Point for one of the following effects (these remain in effect for the rest of the game). Each effect can only be gained once per game. At the end of the game, in the event of a tie, you win. 


* +1 to the Armor characteristic for all Vehicle Units in your army.


* +1 to the Evasion characteristic for all Troop Units in your army.


* One additional order for all of your Command Units.</description>
            </rule>
            <rule name="Stretched Thin" id="4341-0f9a-0be9-d637" hidden="false">
              <description>If at the end of any Round your army has 0 Supply or Intel Points, gain one of either of your choice at the beginning of the next Setup Phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="194th Siberian Rifle Division (Novaya Zemlya)" id="d8a4-2c4f-d3d4-9db4" hidden="false" import="true" sortIndex="4" type="upgrade">
          <rules>
            <rule name="Marena’s Kiss" id="5451-6766-1124-6df1" hidden="false">
              <description>The Category of the Blizzard from the General Winter National Ideal may be increased any number of times each round.</description>
            </rule>
            <rule name="More Power!" id="26fb-2230-dc70-dd1d" hidden="false">
              <description>When a unit in this army performs the Freeze action, before any dice are rolled, it may sacrifice up to 4 of its own HP, adding a +1 bonus to the Freeze roll for every 2 points of HP that was sacrificed. A unit may not sacrifice all of its remaining HP in this fashion, as it still needs to be alive to perform the action.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Bogatyr Security Group (Ohkotsk Techno-Union)" id="2980-c3cf-0984-b120" hidden="false" import="true" sortIndex="5" type="upgrade">
          <rules>
            <rule name="Knives in the Dark" id="113f-7c22-007c-3db7" hidden="false">
              <description>Corporate Officers and Mercenary Units in your army gain Intel Gathering. Additionally, you may spend Intel points instead of Supply points for the purposes of the Mercenary Units Private Military Contractors Ability.</description>
            </rule>
            <rule name="Inhuman Technology" id="5dcb-ea9b-f41c-b04e" hidden="false">
              <description>When you make an attack with an Ablation Beam weapon, a minimum of half of the Hits are always treated as successful.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="12th Ural Motor-Rifle Division (Nastyeviks)" id="2ffa-b444-eb67-3c9e" hidden="false" import="true" sortIndex="6" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization requires at least two Pravoslavny
Kapellans, two Snowbringer Starets Sleighs, or one of each.">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="bd39-4ffb-780b-8748" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                        <condition childId="0041-e696-3d23-be25" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <conditions>
                    <condition childId="bd39-4ffb-780b-8748" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="2"/>
                    <condition childId="0041-e696-3d23-be25" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="2"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Warriors of St. Mikhail" id="527c-1206-0d7a-6218" hidden="false">
              <description>At the beginning of each Round, for each Objective Marker that you control, choose one of the following bonuses, it is applied until the end of the round:

* Re-roll Hit Rolls of 1
* Re-roll Armor Penetration Rolls of 1
* Increase Movement by 2”
* Bulwark 1 on Troops Units
* Ignore Rough Terrain</description>
            </rule>
            <rule name="In the Metropolitan’s Service" id="ff96-e380-5f10-6e47" hidden="false">
              <description>For each Pravoslavny Kapellan Section or Snowbringer Starets Sleigh, select one model in that unit to be an Icon Bearer, granting them one of the Icons listed below. At the beginning of each Round, select one Icon Bearer that is on the battlefield and has not been selected in a previous Round, conferring their bonus to your army. Each Icon may only be taken once, regardless of how many units in your army are eligible to be Icon Bearers.


* St. Mikhail: Attacks made against a Unit by Weapons with 6AP or lower reduce their Damage profile by 2, to a minimum of 1.
* St. Dmitriy: For every two Levels of Blizzard a Unit is in, increase its Evasion by 1
* St. Olga: Attacks made by a Unit against Units in Cover reroll 1s and 2s for Armor Checks.
* St. Georg: When a Unit performs an Attack Action against a Unit with more than 13 HP or Armor, you may reroll all instances of 1s and 2s.
* St. Barbara: When a Unit makes Attack Actions at half-range, it gains the Close In special rule.
* St. Ilya: When a Unit performs the Fallback Reaction, it may move towards an enemy Unit rather than away from it.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="1st Kheshig Mounted Guard Division (New Khanate)" id="1b2e-9043-fac2-d6bc" hidden="false" import="true" sortIndex="7" type="upgrade">
          <modifiers>
            <modifier field="error" type="add" value="This Specialization requires at least two Cossack Cavalry units. Field
Commander must be a Cossack Hetman OR Sergeltiin Khan.">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="f2bc-a75e-56aa-bfb9" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="2"/>
                  </conditions>
                  <localConditionGroups>
                    <localConditionGroup field="selections" includeChildForces="true" includeChildSelections="true" repeats="1" scope="6ea8-04f4-b21b-7fcf" type="atLeast" value="1">
                      <conditions>
                        <condition childId="c3ed-9d4b-d0fd-9d5f" field="selections" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                      </conditions>
                    </localConditionGroup>
                  </localConditionGroups>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Parthian Shot" id="9b47-c17b-e2a3-7197" hidden="false">
              <description>Units in this army may make a Free Ranged Attack Action after performing a Disengagement Action.</description>
            </rule>
            <rule name="Had You Not Committed Great Sins" id="e8e6-f42a-ae93-b6d6" hidden="false">
              <description>For every 5 models that are Engaged with the same enemy Unit, all Melee weapon profiles increase their AP by 1, to a maximum of 3.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
