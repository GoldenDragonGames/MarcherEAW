  <sharedRules>
    <rule name="Corporate Sear" id="9c29-d160-9e29-625e" hidden="false">
      <description>Attacks from this weapon ignore armor values less than 7.</description>
    </rule>
    <rule name="Enhanced Plasma" id="1e9a-7694-9079-6b32" hidden="false">
      <description>Each individual weapon in this Unit with Enhanced Plasma applies a Slag Token, as if it were a separate instance of Slag.</description>
    </rule>
    <rule name="Novaya Zemlya Cloud Engine" id="ffea-d5ff-f989-1a15" hidden="false">
      <description>This Unit may take the Freeze Action as a Standard Action. When this Unit performs the Freeze Action, apply one Suppression token to every Unit within X inches of this Model.</description>
    </rule>
    <rule name="Blessed Relic" id="6ba4-7959-19ce-304b" hidden="false">
      <description>This Unit gets +1 to its Bravery Score.</description>
    </rule>
    <rule name="Adjustable Sights" id="58d3-a00a-c0c4-e7d9" hidden="false">
      <description>When making an attack action with this weapon at less than half of its maximum range, this unit gains an Aim Token.</description>
    </rule>
    <rule name="Freeze" id="f31c-1dc3-9251-1d62" hidden="false">
      <description>This Unit may attempt to intensify the Blizzard to the next Category or Maintain the Blizzard’s current Category. If it does, roll a D10, then consult the Blizzard Chart. You may reroll failed rolls once for every Freeze Action that has been taken this round. To take this Action, for every Category Level of the Blizzard, this Unit must be 6&quot; away from all other Units that may take this Action. The Blizzard may not gain more than one Category Level per round.</description>
    </rule>
    <rule name="Pack Gun" id="9fea-0d08-bc4c-84f5" hidden="false">
      <description>Units with the Troop Keyword may Tow this Unit as a Standard Action. This Unit may not be Towed if it is a Battery.</description>
    </rule>
    <rule name="Train Tracks" id="6086-8cc5-1110-441f" hidden="false">
      <description>This Unit must be deployed with its wheels in contact with and properly aligned with the Rail Network. This Unit&apos;s wheels must be in contact and properly aligned with the Rail Network at all times. If this Unit does not fit on the Rail Network during Deployment, it may be placed En Route. If, during the Setup phase, there is enough space on the Rail Network for this Unit to be Deployed, it must be Deployed.</description>
    </rule>
    <rule name="Train Carriage" id="c662-e154-fc43-0ced" hidden="false">
      <description>This Unit must be Deployed within 1&quot; of the BP-21 &quot;Gulyay-Gorod&quot; Armored Train Engine, or any other Units that are being Towed by the BP-21 &quot;Gulyay-Gorod&quot; Armored Train Engine. This Unit may not take any Movement Actions, and, once it has been Deployed, so long as that Unit has not been Destroyed, it is always considered to be Towed by the BP-21 &quot;Gulyay-Gorod&quot; Armored Train Engine. This Unit may take Actions while being Towed. If this Unit is Destroyed, it may no longer be selected to Activate, but remains on the Battlefield and Moves along with the Engine.

This Unit may not take Upgrades.</description>
    </rule>
    <rule name="Rolling Might" id="302b-8478-e4f8-f998" hidden="false">
      <description>If this Unit is within 3&quot; of an objective and has not been destroyed, Enemy Units may not capture it.</description>
    </rule>
  </sharedRules>
