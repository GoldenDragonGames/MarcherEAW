              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Heavy Weapon Element" id="daf4-7c7f-7c00-f4d8" hidden="false" typeId="312c-13ed-50aa-27a6" typeName="Attache Composition">
              <characteristics>
