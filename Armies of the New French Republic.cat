  <sharedRules>
    <rule name="Flare" id="accc-1573-218-8a01" hidden="false">
      <description>At the start of this unit&apos;s activation, it may launch a flare. All allied units within 12&quot; gain +2&quot; to their movement profile until the end of the round. A unit may only be affected by this rule once a round.</description>
    </rule>
    <rule name="Citoyens, aux armes!" id="824a-1c57-2f1e-f874" hidden="false">
      <description>If this Unit is targeted by a Non-Artillery Unit that is more than 16&quot; away from it, they must roll a D10 to Determine Affiliation, on a 6+, they fail to recognize the Partisans as combatants, and must select a different target for their Attack. If a Unit succeeds this check, it does not need to repeat it for future Attacks that target this Unit.</description>
    </rule>
    <rule name="Faire le zouave" id="64f9-13f9-9267-3683" hidden="false">
      <description>After this Unit resolves a Ranged Attack Action, it may perform a Free Move Action.</description>
    </rule>
  </sharedRules>
