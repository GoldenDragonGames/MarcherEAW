    <profile name="Expanded Taupe" id="e631-fd44-683d-6bbc" hidden="false" typeId="1269-adf9-ff97-be76" typeName="Fortification">
      <characteristics>
        <characteristic name="Supply Cost" typeId="56dd-c8a0-4289-fb06">N/A</characteristic>
        <characteristic name="Effect" typeId="6ebb-50ef-b07e-23ab">Medium and Light Vehicle Units, Cavalry Units, and Troop Units in your Army within 3&quot; of an Expanded Taupe may travel through the Secret Tunnels. If they do, select another Expanded Taupe (Or normal Taupe for Troops) within Range, and set the Unit up within 3&quot; of that Token. The Range of this ability is 15&quot; per Action spent to travel. A Unit may not travel in this way more than once per Round.

Area, Light Terrain, Subterranean</characteristic>
        <characteristic name="Dimensions" typeId="0e74-2a74-ad59-2775">100mm Circular</characteristic>
      </characteristics>
    </profile>
