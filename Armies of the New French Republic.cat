  <rules>
    <rule name="Levée En Masse" id="da6c-ffc6-6ce0-9ee7" hidden="true">
      <description>Units with the NFR keyword may transfer Aim tokens to or from friendly Units within 6” of themselves during their Activation.


When a Unit with the NFR Keyword performs an Attack Action, they may spend Aim tokens to increase the A.P. of one of their weapon profiles by one up to two times.</description>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="01ba-2120-7904-bce7" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
                <condition childId="4fc5-7684-3b46-838d" field="selections" includeChildSelections="true" scope="primary-catalogue" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
    </rule>
  </rules>
